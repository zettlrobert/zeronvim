// Repo-local markdownlint config. Overrides ~/.markdownlint.jsonc if that
// exists; consumed by nvim-lint's markdownlint invocation on save/read.
//
// Move this to ~/.markdownlint.jsonc to apply globally instead.
{
  "default": true,

  // MD013 — line length. Kept as a soft guard (180 chars is well past what
  // any prose actually needs) but disabled for tables, code blocks, and
  // headings where wrapping is impractical or wrong.
  "MD013": {
    "line_length": 180,
    "tables": false,
    "code_blocks": false,
    "headings": false
  },

  // MD033 — inline HTML. Allowed; needed for <details>/<summary>, images
  // with size attributes, etc.
  "MD033": false,

  // MD041 — first line must be a top-level heading. Off; READMEs often
  // start with badges or frontmatter.
  "MD041": false,

  // MD024 — duplicate headings. Allowed under different parents (e.g.,
  // "## Steps" repeated across recipe sections).
  "MD024": { "siblings_only": true }
}
